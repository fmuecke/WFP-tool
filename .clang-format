BasedOnStyle: Microsoft
IndentWidth: 4
TabWidth: 4
#UseTab: ForIndentation
ColumnLimit: 100
# Windows SDK headers have required dependency order; in particular,
# fwpmu.h requires windows.h and fwpmtypes.h to have been included first.
SortIncludes: Never
IncludeBlocks: Regroup #Preserve
PointerAlignment: Left
DerivePointerAlignment: false
AllowShortFunctionsOnASingleLine: All
#AllowShortBlocksOnASingleLine: Always
#AllowShortEnumsOnASingleLine: true
#AllowShortIfStatementsOnASingleLine: WithoutElse
#AllowShortLoopsOnASingleLine: true
#AllowShortCaseLabelsOnASingleLine: true
#SpaceBeforeParens: ControlStatements
#NamespaceIndentation: None
AlignAfterOpenBracket: DontAlign
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true
AlignOperands: Align
ConstructorInitializerAllOnOneLineOrOnePerLine: true
ReflowComments: false
BinPackArguments: false
BreakBeforeBraces: Allman
#BreakBeforeBraces: Custom
#BraceWrapping:
#  AfterNamespace: true
#  AfterClass: true
#  AfterStruct: true
#  AfterEnum: true
#  AfterFunction: true
#  AfterControlStatement: true
#  BeforeElse: true
#  BeforeCatch: true
#  IndentBraces: false
#  SplitEmptyFunction: false
#  SplitEmptyRecord: true
#  SplitEmptyNamespace: false
Cpp11BracedListStyle: true
SpaceBeforeCpp11BracedList: true
